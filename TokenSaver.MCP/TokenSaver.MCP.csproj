<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- net*-windows: this host is a Windows service (registry, named pipes) and references
         TokenSaver.WslControl, which must be net*-windows for Community.Wsl.Sdk. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TokenSaver.MCP</AssemblyName>
    <RootNamespace>TokenSaver.MCP</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\TokenSaver.CodeHelper\TokenSaver.CodeHelper.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.Common.Core\TokenSaver.Common.Core.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.Config\TokenSaver.Config.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.ContextHelper\TokenSaver.ContextHelper.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.Docs\TokenSaver.Docs.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.LogHelper\TokenSaver.LogHelper.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.OllamaIntegration\TokenSaver.OllamaIntegration.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.TerminalControl\TokenSaver.TerminalControl.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.TokenEconomy\TokenSaver.TokenEconomy.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.Utilities\TokenSaver.Utilities.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.WslControl\TokenSaver.WslControl.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.LanguageHelpers.CSharp\TokenSaver.LanguageHelpers.CSharp.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.LanguageHelpers.PowerShell\TokenSaver.LanguageHelpers.PowerShell.csproj" />
    <ProjectReference Include="..\..\Core\TokenSaver.LanguageHelpers.Python\TokenSaver.LanguageHelpers.Python.csproj" />
    <ProjectReference Include="..\..\AgentHelpers\TokenSaver.AgentHelpers.Core\TokenSaver.AgentHelpers.Core.csproj" />
    <ProjectReference Include="..\..\AgentHelpers\TokenSaver.AgentHelpers.Anthropic\TokenSaver.AgentHelpers.Anthropic.csproj" />
    <ProjectReference Include="..\..\AgentHelpers\TokenSaver.AgentHelpers.Qwen\TokenSaver.AgentHelpers.Qwen.csproj" />
    <ProjectReference Include="..\..\AgentHelpers\TokenSaver.AgentHelpers.DeepSeek\TokenSaver.AgentHelpers.DeepSeek.csproj" />
    <ProjectReference Include="..\..\AgentHelpers\TokenSaver.AgentHelpers.OpenSource\TokenSaver.AgentHelpers.OpenSource.csproj" />
    <PackageReference Include="SperryDev.Logger" Version="$(SperryLoggerVersion)" />
    <ProjectReference Include="..\..\Common\TokenSaver.Common.Installation\TokenSaver.Common.Installation.csproj" />
    <ProjectReference Include="..\..\Common\TokenSaver.Common.Models\TokenSaver.Common.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Core\TokenSaver.TerminalControl\Scripts\tokensaver-tab.ps1" Link="Scripts\tokensaver-tab.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- UnhandledFaultTracker, FaultTrackingMiddleware, UnhandledFaultHealthCheck, and
         SelfTestHealthCheck are all internal — deliberately not public API. TokenSaver.MCP.Tests
         needs to construct/reference them directly (and reach SelfTestHealthCheck.ExtraChecks to
         inject a deliberately-failing check) to exercise the degraded-health wiring end to end
         without needing to break real config/wiring, so assembly-level access is granted here
         rather than making any of these types public. -->
    <InternalsVisibleTo Include="TokenSaver.MCP.Tests" />
  </ItemGroup>

  <!--
    Opt in hook to build the WiX installer immediately after "dotnet publish".

    Deliberately NOT wired to run on every publish or on "dotnet build" (including a
    solution wide build of TokenSaverMCP.slnx): this shells out to a separate
    publish-tokensaver-for-wix.ps1 script that does its own dotnet publish into
    build\staging\TokenSaver.MCP and then builds src\Installers\TokenSaver.Setup, which is a
    much heavier and slower step than a normal build and requires the WiX .NET tool
    (dotnet tool install -g wix). That would be a surprising side effect of an
    ordinary build or of CI publishing this project. This only fires when the caller
    explicitly opts in by setting the BuildInstaller MSBuild property to "true" on the
    publish command line. The version baked into the installer can be overridden via the
    InstallerVersion MSBuild property; it otherwise defaults to whatever
    publish-tokensaver-for-wix.ps1 itself defaults to.

    See src/Installers/TokenSaver.Setup and scripts/publish-tokensaver-for-wix.ps1 for
    what this actually does and why it's a separate script rather than being inlined here.
  -->
  <PropertyGroup>
    <BuildInstaller Condition="'$(BuildInstaller)' == ''">false</BuildInstaller>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''"></InstallerVersion>
  </PropertyGroup>

  <!--
    Stops the installed TokenSaverMCP Windows service before a Debug build, if it's running —
    otherwise an F5/Ctrl+F5 dev session loses the race to bind port 11436 against the service.
    Mirrors run-dev-server.ps1's own service-stop step. Elevates (one UAC prompt) only when the
    service is actually running and this process isn't already elevated; a stopped/not-installed
    service means this is a no-op with no prompt. Scoped to Debug + Windows so it never fires
    during a Release publish (rebuild-and-replace-mcp.ps1 owns that path) or non-Windows CI.
    Also scoped to an F5 dev session (Visual Studio) or an explicit -p:TokenSaverStopService=true:
    plain "dotnet build"/"dotnet test" must NOT stop the always-on service, because that kills any
    in-flight index run and forces the next one to start over.
  -->
  <Target Name="StopTokenSaverServiceForDebug" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug' AND ('$(BuildingInsideVisualStudio)' == 'true' OR '$(TokenSaverStopService)' == 'true')">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\..\scripts\stop-service-for-debug.ps1&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="BuildTokenSaverInstaller" AfterTargets="Publish" Condition="'$(BuildInstaller)' == 'true'">
    <Error Text="BuildInstaller is only supported on Windows (it packages a Windows service installer via WiX)." Condition="'$(OS)' != 'Windows_NT'" />
    <PropertyGroup>
      <_InstallerVersionArg Condition="'$(InstallerVersion)' != ''">-Version $(InstallerVersion)</_InstallerVersionArg>
    </PropertyGroup>
    <Message Importance="high" Text="BuildInstaller=true - invoking publish-tokensaver-for-wix.ps1 $(_InstallerVersionArg) -Pack" />
    <!--
      Deliberately does NOT reuse $(PublishDir) from this MSBuild-triggered publish: that
      directory is this project's own build output folder, not the installer's expected
      staging location (build\staging\TokenSaver.MCP). publish-tokensaver-for-wix.ps1 owns
      publishing into its own staging directory and then building the WiX project - let it
      do that itself, exactly as if it had been run manually, rather than trying to reuse
      this publish's output in place. This makes the publish that produced $(PublishDir)
      here redundant with the one the script performs, but keeps the staging path correct
      and identical to a manual run of the script.
    -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\..\scripts\publish-tokensaver-for-wix.ps1&quot; $(_InstallerVersionArg) -Pack" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>
</Project>
